{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(python -m pip list)",
      "Bash(pip list)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s localhost:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./backend/.venv/**)",
      "Read(./node_modules/**)",
      "Bash(python clear_db.py)",
      "Bash(python backend/clear_db.py)",
      "Bash(python seed.py --reset)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
